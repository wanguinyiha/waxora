# Copy to `.env` for local development, Docker Compose and `docker run --env-file`.
# Never commit the filled-in file: `.env*` is git-ignored, `.env.example` is not.

# ── Public (inlined into the JS bundle at `next build`) ───────────────────────
# These MUST be present when the Docker image is built (build args), because
# they are frozen into the bundle and into middleware at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Public, also safe to expose, optional ─────────────────────────────────────
# Used for booking management links. Falls back to the request Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_TIMEZONE=Africa/Nairobi

# ── Server-only secrets (runtime only — never pass as Docker build args) ──────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SMTP (server-only, optional) ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
# Recipient of contact-form notifications (falls back to SMTP_USER).
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ── Timezone fallback (server-only) ───────────────────────────────────────────
BUSINESS_TIMEZONE=Africa/Nairobi

# ── Only used by `npm run seed:admin` (never in an image) ─────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-long-random-password
